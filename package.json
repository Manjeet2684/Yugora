{
  "name": "yugora",
  "version": "0.1.0",
  "private": true,
  "description": "YUGORA — a privacy-first social discovery platform built around mutual interest and reciprocal matching.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build:architecture": "tsc",
    "test:architecture": "npm run build:architecture && node --test tests/architecture.test.mjs",
    "test:persistence": "npm run db:deploy && npm run db:seed && npm run db:seed && node --test tests/persistence.integration.test.mjs",
    "check": "npm run db:validate && npm run typecheck && npm run test:architecture && npm run test:persistence && npm run test:http && npm run build:next && npm run test:ui && npm run test:copyright",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:http": "npm run db:deploy && npm run db:seed && node --test tests/http.integration.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:next": "next build",
    "start": "next start",
    "test:ui": "npm run build:architecture && node --test tests/ui-logic.test.mjs",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:copyright": "node --test tests/copyright-headers.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.3",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "16.6.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "author": "Manjeet2684"
}
