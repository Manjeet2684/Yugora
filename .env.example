# Pooled PostgreSQL URL for Next.js application runtime.
DATABASE_URL="postgresql://yugora:yugora@127.0.0.1:5432/yugora?schema=public"
# Direct, unpooled URL for Prisma CLI migrations (Neon: DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED="postgresql://yugora:yugora@127.0.0.1:5432/yugora?schema=public"
# Neon Auth managed Better Auth endpoint. Leave unset for local demo mode.
NEON_AUTH_BASE_URL=""
# Local/CI only. Never set this to "demo" on a deployed environment.
YUGORA_TEST_IDENTITY=""
# Preview only: enables one-click access to the shared single-user assignment demo.
# Never enable this in Production; Production ignores it even if mistakenly configured.
YUGORA_PUBLIC_DEMO_MODE="false"
